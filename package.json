    "eslint": "^9.39.5",
    "globals": "^17.12.0",
    "htmlhint": "^1.9.2",
    "prettier": "^3.9.7",
    "stylelint": "^17.15.0",
    "stylelint-config-standard": "^40.0.0"
  }
}
